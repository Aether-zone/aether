# Copy to `api/.env`. Loaded and validated at boot by organon's config module,
# which fails the start on anything missing or malformed rather than letting it
# surface as `undefined` deep inside a request.

PORT=3040
LOG_LEVEL=debug

# pistis, the aether-zone authorization server. aether verifies its tokens and
# issues none of its own, so there is no signing key here — only the issuer to
# check them against. Must match the `iss` claim exactly.
OAUTH_ISSUER=http://localhost:3001

# `aud` every accepted token must carry, and where pistis publishes its keys.
# Both are derived from the issuer when unset, which is what a normal
# deployment wants.
# OAUTH_AUDIENCE=
# OAUTH_JWKS_URI=

# SQLite, in a file beside the process. `DATABASE_SYNCHRONIZE` lets TypeORM
# create and alter tables to match the entities; it defaults on outside
# production so a fresh checkout runs, and it is not a migration strategy —
# it drops columns whose entity fields disappear, data included.
DATABASE_PATH=./aether.sqlite
# DATABASE_SYNCHRONIZE=true
