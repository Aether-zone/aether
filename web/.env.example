# Copy to `web/.env`. aether signs in through pistis, the aether-zone
# authorization server; there is no account store here. These values register
# the console as an OAuth client of it, and the client has to exist in pistis
# first as `aether`, with the redirect URI below.

# The pistis API: mints the tokens, publishes the keys the aether api checks
# them against. Must match the `iss` claim exactly.
OAUTH_ISSUER=http://localhost:3001

# The pistis *web* app's consent screen — a different origin from the issuer.
# `GET /api/oauth/authorize` answers with JSON describing the pending request
# rather than redirecting, so the browser has to be sent to the app that
# renders the consent UI, not to the API.
OAUTH_CONSENT_URL=http://localhost:3002/login

OAUTH_CLIENT_ID=aether
# Handed out once when the client is registered in pistis, and stored there
# only as a bcrypt hash — if it is lost it has to be rotated, not recovered.
OAUTH_CLIENT_SECRET=

# Must be registered against the client in pistis; it refuses any other value.
OAUTH_REDIRECT_URI=http://localhost:3042/api/auth/callback

# `profile` is what /oauth/userinfo needs to return a name at all;
# `organizations` puts the `orgs` claim on the token that the sidebar's
# switcher reads.
OAUTH_SCOPES=profile email organizations

# The aether api, for server-side calls carrying the access token. Must agree
# with api/.env — the workspace reserves 3040 for the api, 3042 for this app.
AETHER_API_URL=http://localhost:3040
